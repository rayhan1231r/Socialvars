{
  "entities": {
    "UserPublic": {
      "title": "UserPublic",
      "description": "Publicly readable SocialVerse user profile without PII.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "username": { "type": "string", "minLength": 3, "maxLength": 24, "pattern": "^[a-z0-9_]{3,24}$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 50 },
        "nicknameFont": { "type": "string", "enum": ["classic", "serif", "mono", "display", "italic"] },
        "bio": { "type": "string", "maxLength": 150 },
        "pronouns": { "type": "string", "maxLength": 32 },
        "website": { "type": "string", "maxLength": 200 },
        "photoUrl": { "type": "string", "maxLength": 200000 },
        "coverUrl": { "type": "string", "maxLength": 200000 },
        "interests": { "type": "array" },
        "isPrivate": { "type": "boolean" },
        "isDeactivated": { "type": "boolean" },
        "deactivatedUntil": { "type": "string", "format": "date-time" },
        "followersCount": { "type": "integer" },
        "followingCount": { "type": "integer" },
        "postsCount": { "type": "integer" },
        "onlineStatus": { "type": "string", "enum": ["online", "offline", "away"] },
        "lastSeenAt": { "type": "string", "format": "date-time" },
        "lastNicknameChangedAt": { "type": "string", "format": "date-time" },
        "lastUsernameChangedAt": { "type": "string", "format": "date-time" },
        "onboardingCompleted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username", "displayName", "isPrivate", "followersCount", "followingCount", "postsCount", "onboardingCompleted", "createdAt"]
    },
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Owner-only PII and privacy/notification/security preferences.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "language": { "type": "string", "enum": ["en", "bn"] },
        "themeMode": { "type": "string", "enum": ["light", "dark", "system"] },
        "biometricLockEnabled": { "type": "boolean" },
        "twoFactorEnabled": { "type": "boolean" },
        "saveLoginInfo": { "type": "boolean" },
        "whoCanMessage": { "type": "string", "enum": ["everyone", "followers", "nobody"] },
        "whoCanViewStories": { "type": "string", "enum": ["everyone", "followers", "close_friends"] },
        "whoCanFollow": { "type": "string", "enum": ["everyone", "approval"] },
        "notificationPrefs": { "type": "object" },
        "blockedUserIds": { "type": "array" },
        "mutedStoryUserIds": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "language", "whoCanMessage", "whoCanViewStories", "updatedAt"]
    },
    "UsernameClaim": {
      "title": "UsernameClaim",
      "description": "Unique username reservation mapping lowercase username to uid and encrypted email lookup token.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "username": { "type": "string", "minLength": 3, "maxLength": 24, "pattern": "^[a-z0-9_]{3,24}$" },
        "encEmail": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username", "createdAt"]
    },
    "EmailClaim": {
      "title": "EmailClaim",
      "description": "Canonical email SHA-256 reservation enforcing one account per Gmail/email without storing plaintext PII.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "emailHash": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$" },
        "encEmail": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "emailHash", "createdAt"]
    },
    "Post": {
      "title": "Post",
      "description": "Feed post supporting text, photo, multi-image carousel, video, and reels.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorUsername": { "type": "string", "minLength": 3, "maxLength": 24 },
        "authorDisplayName": { "type": "string", "minLength": 1, "maxLength": 50 },
        "authorAvatar": { "type": "string", "maxLength": 1000 },
        "caption": { "type": "string", "maxLength": 2200 },
        "mediaUrls": { "type": "array" },
        "coverUrl": { "type": "string", "maxLength": 200000 },
        "mediaType": { "type": "string", "enum": ["text", "image", "carousel", "video", "reel"] },
        "hashtags": { "type": "array" },
        "likesCount": { "type": "integer" },
        "commentsCount": { "type": "integer" },
        "sharesCount": { "type": "integer" },
        "visibility": { "type": "string", "enum": ["public", "followers", "only_me"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "authorId", "authorUsername", "authorDisplayName", "caption", "mediaType", "likesCount", "commentsCount", "sharesCount", "visibility", "createdAt"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Comment or threaded reply on a post.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "postId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorUsername": { "type": "string", "minLength": 3, "maxLength": 24 },
        "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "stickerUrl": { "type": "string", "maxLength": 200000 },
        "gifUrl": { "type": "string", "maxLength": 200000 },
        "parentCommentId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "postId", "authorId", "authorUsername", "text", "createdAt"]
    },
    "Story": {
      "title": "Story",
      "description": "Ephemeral 24-hour photo, video, or text story.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorUsername": { "type": "string", "minLength": 3, "maxLength": 24 },
        "mediaType": { "type": "string", "enum": ["photo", "video", "text"] },
        "mediaUrl": { "type": "string", "maxLength": 1000 },
        "textContent": { "type": "string", "maxLength": 500 },
        "privacy": { "type": "string", "enum": ["everyone", "followers", "close_friends"] },
        "viewersCount": { "type": "integer" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "authorId", "authorUsername", "mediaType", "privacy", "viewersCount", "expiresAt", "createdAt"]
    },
    "Chat": {
      "title": "Chat",
      "description": "1:1 or group chat thread metadata supporting up to 250 members and themes.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "enum": ["direct", "group"] },
        "title": { "type": "string", "maxLength": 80 },
        "participantIds": { "type": "array" },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "adminUids": { "type": "array" },
        "requireAddApproval": { "type": "boolean" },
        "theme": { "type": "object" },
        "chatNicknames": { "type": "object" },
        "lastMessageText": { "type": "string", "maxLength": 300 },
        "lastMessageAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "type", "participantIds", "createdBy", "createdAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Real-time message in a chat (text, voice, image, video, file, sticker, reel_share).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "chatId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "enum": ["text", "voice", "image", "video", "file", "sticker", "reel_share"] },
        "text": { "type": "string", "maxLength": 2000 },
        "mediaUrl": { "type": "string", "maxLength": 200000 },
        "stickerUrl": { "type": "string", "maxLength": 200000 },
        "sharedPostId": { "type": "string", "maxLength": 128 },
        "durationMs": { "type": "integer" },
        "replyToId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["sent", "delivered", "seen"] },
        "reactions": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "chatId", "senderId", "type", "status", "createdAt"]
    },
    "FriendRequest": {
      "title": "FriendRequest",
      "description": "Follow or friend request between two users.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fromUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "toUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fromUid", "toUid", "status", "createdAt"]
    },
    "FollowerEdge": {
      "title": "FollowerEdge",
      "description": "Directional follower edge (followerUid follows targetUid).",
      "type": "object",
      "properties": {
        "followerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["followerUid", "targetUid", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User-scoped activity notification.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "recipientUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "enum": ["follow", "friend_request", "like", "comment", "reply", "story_reaction", "message", "group_message", "mention", "announcement"] },
        "targetId": { "type": "string", "maxLength": 128 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "recipientUid", "actorUid", "type", "read", "createdAt"]
    },
    "SavedPost": {
      "title": "SavedPost",
      "description": "Bookmark entry owned by a user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "postId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "postId", "createdAt"]
    },
    "Report": {
      "title": "Report",
      "description": "User-submitted moderation report for posts, stories, or accounts.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "reporterUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetType": { "type": "string", "enum": ["post", "user", "story", "comment"] },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "reason": { "type": "string", "minLength": 3, "maxLength": 500 },
        "status": { "type": "string", "enum": ["pending", "reviewed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "reporterUid", "targetType", "targetId", "reason", "status", "createdAt"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "System-wide announcement written only by admins/backend.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 140 },
        "body": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "body", "createdAt"]
    },
    "Note": {
      "title": "Note",
      "description": "24-hour Inbox status note with likes.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorUsername": { "type": "string", "minLength": 3, "maxLength": 24 },
        "authorDisplayName": { "type": "string", "minLength": 1, "maxLength": 50 },
        "text": { "type": "string", "minLength": 1, "maxLength": 80 },
        "likedByUids": { "type": "array" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "authorUid", "authorUsername", "text", "expiresAt", "createdAt"]
    },
    "Sticker": {
      "title": "Sticker",
      "description": "Custom or saved sticker/GIF asset.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "creatorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 50 },
        "imageUrl": { "type": "string", "maxLength": 200000 },
        "kind": { "type": "string", "enum": ["sticker", "gif"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "creatorUid", "label", "imageUrl", "kind", "createdAt"]
    },
    "BroadcastChannel": {
      "title": "BroadcastChannel",
      "description": "Creator broadcast channel unlocked at 500 followers.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "maxLength": 300 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "adminUids": { "type": "array" },
        "moderatorUids": { "type": "array" },
        "collaboratorUids": { "type": "array" },
        "followerUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "ownerUid", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublic" },
      "description": "Public user profiles (PII-free)."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivate" },
      "description": "Owner-only private user settings, email, and blocklists."
    },
    "/usernames/{username}": {
      "schema": { "$ref": "#/entities/UsernameClaim" },
      "description": "Unique lowercase username reservation documents."
    },
    "/email_claims/{emailHash}": {
      "schema": { "$ref": "#/entities/EmailClaim" },
      "description": "One-way SHA-256 canonical email reservations (1 account per Gmail)."
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/Post" },
      "description": "Public and follower-scoped posts and reels."
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/Comment" },
      "description": "Comments and replies nested under each post."
    },
    "/stories/{storyId}": {
      "schema": { "$ref": "#/entities/Story" },
      "description": "24-hour expiring stories."
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/Chat" },
      "description": "Direct and group chat metadata."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Messages belonging to a chat."
    },
    "/friend_requests/{requestId}": {
      "schema": { "$ref": "#/entities/FriendRequest" },
      "description": "Pending and resolved friend/follow requests."
    },
    "/followers/{edgeId}": {
      "schema": { "$ref": "#/entities/FollowerEdge" },
      "description": "Follower relationship edges."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Notifications scoped strictly to recipientUid."
    },
    "/saved_posts/{saveId}": {
      "schema": { "$ref": "#/entities/SavedPost" },
      "description": "Bookmarks scoped strictly to owner uid."
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/Report" },
      "description": "Abuse reports readable/writable only by reporter or backend admin."
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/Announcement" },
      "description": "Read-only announcements published by the separate Admin App."
    },
    "/notes/{noteId}": {
      "schema": { "$ref": "#/entities/Note" },
      "description": "24-hour Inbox notes shared by users."
    },
    "/stickers/{stickerId}": {
      "schema": { "$ref": "#/entities/Sticker" },
      "description": "User-created custom stickers and GIFs."
    },
    "/broadcast_channels/{channelId}": {
      "schema": { "$ref": "#/entities/BroadcastChannel" },
      "description": "Creator broadcast channels unlocked at 500+ followers."
    }
  }
}
